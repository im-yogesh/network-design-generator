{% if bgp %}
ip route {{ bgp.advertise.net }} {{ bgp.advertise.mask }} Null0 name BGP_ANCHOR
ip prefix-list ADVERTISE seq 10 permit {{ bgp.advertise.net }}/{{ bgp.advertise.mask | prefixLen }}
router bgp {{ bgp.asn }}
 bgp router-id {{ routerId }}
 bgp log-neighbor-changes
{% for n in bgp.neighbors %}
 neighbor {{ n.ip }} remote-as {{ n.remoteAs }}
 neighbor {{ n.ip }} description {{ n.isp }}-PE
{% endfor %}
 address-family ipv4
  network {{ bgp.advertise.net }} mask {{ bgp.advertise.mask }}
{% for n in bgp.neighbors %}
  neighbor {{ n.ip }} activate
  neighbor {{ n.ip }} prefix-list ADVERTISE out
{% endfor %}
 exit-address-family
{% endif %}
